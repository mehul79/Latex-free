# Generate a secret with: openssl rand -hex 32. Use the same token in apps/api/.env.
WORKER_TOKEN=replace-with-a-random-secret-at-least-32-characters
COMPILER_HOST=127.0.0.1
COMPILER_PORT=4100
TEX_IMAGE=latex-free-tex:local
# Optional absolute path on the Docker daemon's host; worker must also see it.
# COMPILER_TMPDIR=/tmp
